{
  "name": "ShadeBootloader",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=shadebootloader-claude,target=/home/vscode/.claude,type=volume",
    "source=shadebootloader-gh,target=/home/vscode/.config/gh,type=volume"
  ],
  "forwardPorts": [1234, 6080, 5700],
  "portsAttributes": {
    "1234": { "label": "QEMU GDB stub", "onAutoForward": "silent" },
    "6080": { "label": "Shade VM (noVNC)", "onAutoForward": "openBrowser" },
    "5700": { "label": "QEMU VNC websocket", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "13xforever.language-x86-64-assembly",
        "ms-vscode.hexeditor"
      ]
    }
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.config/gh; (gh auth status >/dev/null 2>&1 && gh auth setup-git) || echo 'Run: gh auth login'; claude --version; qemu-system-x86_64 --version | head -n1; clang --version | head -n1"
}
